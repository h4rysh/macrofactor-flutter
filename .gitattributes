# Normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.dart text
*.md text
*.yml text
*.yaml text
*.json text
*.xml text
*.kt text
*.sh text eol=lf
*.py text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.db binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
*.svg text

# GitHub Linguist Overrides
build/* linguist-vendored
coverage/* linguist-vendored
.dart_tool/* linguist-vendored
ios/Pods/* linguist-vendored
*.g.dart linguist-generated
*.freezed.dart linguist-generated
docs/* linguist-documentation
.github/* linguist-documentation
